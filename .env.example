# SSH Workbench Configuration
# Copy this file to .env and fill in the required values

# REQUIRED: Web login password (min 8 characters)
APP_PASSWORD=

# REQUIRED: AES-256-GCM master key for SSH credentials (min 32 characters)
# Generate with: openssl rand -hex 32
# IMPORTANT: Back this up separately — losing it makes saved credentials unrecoverable
CREDENTIAL_ENCRYPTION_KEY=

# Optional: Port the server listens on
PORT=5234

# Optional: Set to true when accessed over HTTPS (e.g. behind reverse proxy)
COOKIE_SECURE=false

# Optional: Exact browser origin(s), e.g. https://ssh.example.com
# Recommended when using a reverse proxy; comma-separated for multiple values
ALLOWED_ORIGIN=

# Optional: Express trust proxy setting. Set to 1 when behind a single reverse proxy.
# TRUST_PROXY=1

# Optional: Login session lifetime in days
# SESSION_DAYS=30

# Optional: SSH connection timeouts in milliseconds
# SSH_READY_TIMEOUT_MS=12000
# SSH_COMMAND_TIMEOUT_MS=10000

{
  "name": "ssh-workbench",
  "version": "1.0.0",
  "description": "Self-hosted web SSH terminal with persistent tmux sessions",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/your-org/ssh-workbench#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ssh-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/ssh-workbench/issues"
  },
  "keywords": [
    "ssh",
    "terminal",
    "web-terminal",
    "tmux",
    "self-hosted",
    "websocket",
    "xterm"
  ],
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.8.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
